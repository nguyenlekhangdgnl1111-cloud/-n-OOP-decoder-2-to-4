`timescale 1ps/1ps
module tb ;
  reg clk ;
  reg reset,preset;
  reg j,k;
  wire q,not_q ;
  
  ff_jk ff1(
    .clk(clk),
    .reset(reset),
    .preset(preset),
    .j(j),
    .k(k),
    .q(q),
    .not_q(not_q)
    );
  initial begin
   forever  #5 clk = ~clk ; 
  end
  initial begin
    $monitor("|| time = %d || CK = %b || j = %b || k = %b || q = %b || not_q = %b ||",$time,clk,j,k,q,not_q);
     clk = 1'b0;
     reset = 1'b0;
     #5;
  reset = 1'b1;
 #5;
 j = 1'b0 ; k = 1'b0 ; preset = 1'b0;
  #5;
 j = 1'b0 ; k = 1'b0 ; preset = 1'b1;

  #5;
 j = 1'b0 ; k = 1'b1 ; preset = 1'b0;
  #5;
 j = 1'b0 ; k = 1'b1 ; preset = 1'b1;

  #5;
 j = 1'b1 ; k = 1'b0 ; preset = 1'b0;
  #5;
 j = 1'b1 ; k = 1'b0 ; preset = 1'b1;

  #5;
 j = 1'b1 ; k = 1'b1 ; preset = 1'b0;
  #5;
 j = 1'b1 ; k = 1'b1 ; preset = 1'b1;
  #10;
  $finish ;
  end
endmodule   
