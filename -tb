`timescale 1ps/1ps
module tb;
logic [3:0] reset ;
logic  clk ;
logic [3:0] preset;
logic [3:0] q , not_q ;

counter_4bit uut (
        .clk(clk),
        .reset(reset),
        .preset(preset),
        .q(q),
        .not_q(not_q)
    );

initial begin
forever #5 clk = ~clk ;    
end

initial begin
reset  = 4'b0000; 
preset = 4'b1111;
clk = 0 ; 
  $monitor("||time = %d || Q= %b(%d) ||",$time,q,q);

#5;
reset = 4'b1111;



#160;
$finish;
end

initial begin
$dumpfile("dump.vcd");
$dumpvars(0,tb);  
end

endmodule
