`timescale 1ns/1ps
module tb ;
  reg clk ;
  reg reset;
  reg preset;
  reg j;
  reg k;
  logic q;
  logic not_q;
  
  ff_jk ff1(
    .clk(clk),
    .reset(reset),
    .preset(preset),
    .j(j),
    .k(k),
    .q(q),
    .not_q(not_q)
    );
  initial begin
   forever  #5 clk = ~clk ; 
  end
  initial begin
    $monitor("|| time = %d || reset = %b || CK = %b || j = %b || k = %b || q = %b || not_q = %b ||",$time,reset,clk,j,k,q,not_q);
     clk = 0 ;
    reset = 1'b0;
   #5;
  reset = 1'b1;
   #5;
   j = 0 ; k = 0 ; q = 0 ;
   #5;
   j = 0 ; k = 0 ; q = 1;
   
   #5;
   j = 0 ; k = 1; q = 0 ;
   #5;
   j = 0 ; k = 1; q = 1;
    
   #5;
   j = 1; k = 0 ; q = 0 ;
   #5;
   j = 1; k = 0 ; q = 1;
    
   #5;
   j = 1; k = 1; q = 0 ;
   #5;
   j = 1; k = 1; q = 1;
    

    
  $finish ;
  end
endmodule   
